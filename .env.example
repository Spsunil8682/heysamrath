# ─── Required ────────────────────────────────────────────────────────────────
# Supabase → Project Settings → API Keys / Data API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The PUBLISHABLE key (sb_publishable_…). Safe in the browser because RLS protects every table.
# (The legacy "anon" key also works via NEXT_PUBLIC_SUPABASE_ANON_KEY until Supabase retires it.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Public URL of the site, used for sitemap, robots and Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── NOT needed ──────────────────────────────────────────────────────────────
# This app never uses the Supabase secret/service-role key. Do not add it.
# Never put any secret in a variable that starts with NEXT_PUBLIC_.

# ─── Optional: email notifications to the owner (server-only) ───────────────
# Leave empty to disable. Bookings still work; notification failures never block them.
RESEND_API_KEY=
EMAIL_FROM="Hey Samrath <bookings@your-verified-domain.com>"
OWNER_NOTIFICATION_EMAIL=

# ─── Optional, later: Cloudinary (server-only except the cloud name) ────────
# Only needed when you add signed uploads (see docs/CLOUDINARY.md). Playback of Cloudinary URLs
# stored in the database needs no variables at all.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
